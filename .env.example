# Скопіюйте цей файл у .env.local (не комітиться, вже в .gitignore) і заповніть реальними значеннями.

# Anthropic — генерація казок (Project Settings → API Keys на console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase — Project Settings → API на supabase.com/dashboard
# NEXT_PUBLIC_SUPABASE_URL: "Project URL"
# SUPABASE_SERVICE_ROLE_KEY: "service_role" ключ (НЕ "anon" — service_role потрібен для
# запису з серверного коду; ніколи не використовуйте цей ключ у клієнтських компонентах)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
